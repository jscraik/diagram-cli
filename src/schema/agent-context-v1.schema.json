{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://archscope.dev/schemas/agent-context-v1.json",
  "title": "Archscope Agent Context v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "generatedBy",
    "mode",
    "summary",
    "artifacts",
    "components",
    "readOrder",
    "agentInstructions",
    "warnings",
    "errors",
    "partial"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "generatedBy": { "type": "string" },
    "mode": { "enum": ["repository", "pr"] },
    "partial": { "type": "boolean" },
    "summary": {
      "type": "object",
      "required": [
        "componentCount",
        "entryPointCount",
        "totalFilesFound",
        "languages",
        "architectureAreas"
      ],
      "properties": {
        "componentCount": { "type": "integer", "minimum": 0 },
        "entryPointCount": { "type": "integer", "minimum": 0 },
        "totalFilesFound": { "type": "integer", "minimum": 0 },
        "languages": { "type": "object" },
        "architectureAreas": { "type": "object" }
      },
      "additionalProperties": false
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "path", "role", "status"],
        "properties": {
          "id": { "type": "string" },
          "path": { "type": "string" },
          "role": { "type": "string" },
          "status": { "enum": ["written", "deferred", "partial", "failed"] },
          "reason": { "type": "string" },
          "errorCategory": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "name",
          "path",
          "type",
          "roleTags",
          "dependencyCount",
          "source",
          "derivation"
        ],
        "properties": {
          "kind": { "const": "component" },
          "name": { "type": "string" },
          "path": { "type": "string" },
          "type": { "type": "string" },
          "roleTags": {
            "type": "array",
            "items": { "type": "string" }
          },
          "dependencyCount": { "type": "integer", "minimum": 0 },
          "source": { "const": "analysis.components" },
          "derivation": { "const": "static-analysis" }
        },
        "additionalProperties": false
      }
    },
    "readOrder": {
      "type": "array",
      "items": { "type": "string" }
    },
    "agentInstructions": {
      "type": "object",
      "required": [
        "readFirst",
        "safeToSkip",
        "beforeEditing",
        "whenBlocked",
        "partialEvidence",
        "nextSafeAction"
      ],
      "properties": {
        "readFirst": {
          "type": "array",
          "items": { "type": "string" }
        },
        "safeToSkip": {
          "type": "array",
          "items": { "type": "string" }
        },
        "beforeEditing": {
          "type": "array",
          "items": { "type": "string" }
        },
        "whenBlocked": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["action", "retryable", "humanRequired", "message"],
            "properties": {
              "action": { "type": "string" },
              "retryable": { "type": "boolean" },
              "humanRequired": { "type": "boolean" },
              "message": { "type": "string" },
              "fallbackAction": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "partialEvidence": {
          "type": "object",
          "required": [
            "status",
            "canUseWrittenEvidence",
            "instruction",
            "blockedArtifacts"
          ],
          "properties": {
            "status": { "enum": ["complete", "limited"] },
            "canUseWrittenEvidence": { "type": "boolean" },
            "instruction": { "type": "string" },
            "blockedArtifacts": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["artifact", "path", "status"],
                "properties": {
                  "artifact": { "type": "string" },
                  "path": { "type": "string" },
                  "status": { "enum": ["written", "deferred", "partial", "failed"] },
                  "reason": { "type": "string" },
                  "category": { "type": "string" }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        },
        "nextSafeAction": {
          "type": "object",
          "required": [
            "action",
            "category",
            "retryable",
            "humanRequired",
            "canUseWrittenEvidence",
            "message"
          ],
          "properties": {
            "action": { "type": "string" },
            "category": { "type": ["string", "null"] },
            "retryable": { "type": "boolean" },
            "humanRequired": { "type": "boolean" },
            "canUseWrittenEvidence": { "type": "boolean" },
            "message": { "type": "string" },
            "artifact": { "type": "string" },
            "fallbackAction": { "type": "string" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "warnings": {
      "type": "array",
      "items": { "type": "string" }
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["category", "artifact", "message"],
        "properties": {
          "category": { "type": "string" },
          "artifact": { "type": "string" },
          "message": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "pr": { "type": "object" },
    "base": { "type": "string" },
    "head": { "type": "string" },
    "risk": { "type": ["object", "null"] }
  },
  "additionalProperties": false
}
